# ORCHESTRATION SUBSTITUTION TABLE (2026-08-12)
# Maps the 15 orchestration agents (model: frontmatter in ~/.claude/agents)
# to proxy tiers. The proxy matches requested model -> tier, runs cascade on
# failure, recovers per-minute quota expiry. 3 native Opus slots are NOT listed:
# they pass through to Anthropic directly.
# Format: AGENT_<NAME>_TIER=<tier>  and  AGENT_<NAME>_MODEL=<provider-prefixed id>
# XBIG primary decision (2026-08-12): XBIG_MODEL stays kilo/moonshotai/kimi-k3 —
# strict Pareto frontier member at $0.84 vs gpt-5.6-sol $1.23; the KVK3 slot's
# sol-max intent is documented via AGENT_GPTSOLKVK3_MODEL and reachable by
# flipping XBIG_MODEL when sol is preferred.
# ══════════════════════════════════════════════════════════════════════════════
# Slot               frontmatter model      tier     real backend
AGENT_GPTSOLKVK3_TIER=XBIG
AGENT_GPTSOLKVK3_MODEL=kilo/moonshotai/kimi-k3
AGENT_GPTSOLMAX_TIER=XBIG
AGENT_GPTSOLMAX_MODEL=openai/gpt-5.6-sol
AGENT_KIMIK3MAX_TIER=XBIG
AGENT_KIMIK3MAX_MODEL=kilo/moonshotai/kimi-k3
AGENT_FABLE5MAX_TIER=XBIG
AGENT_FABLE5MAX_MODEL=openai/gpt-5.6-sol
AGENT_GLM52MAX_TIER=BIG
AGENT_GLM52MAX_MODEL=kilo/z-ai/glm-5.2
AGENT_DEEPSEEKFLASH_TIER=MIDDLE
AGENT_DEEPSEEKFLASH_MODEL=opencode/deepseek-v4-flash
AGENT_SPARK_TIER=MIDDLE
AGENT_SPARK_MODEL=opencode/deepseek-v4-flash-free
AGENT_LUNAHIGH_TIER=MIDDLE
AGENT_LUNAHIGH_MODEL=openai/gpt-5.6-luna
AGENT_SONNET5MED_TIER=MIDDLE
AGENT_SONNET5MED_MODEL=opencode/deepseek-v4-flash-free
AGENT_LUNAMED_TIER=MIDDLE
AGENT_LUNAMED_MODEL=openai/gpt-5.6-luna
AGENT_MIMO25_TIER=SMALL
AGENT_MIMO25_MODEL=opencode/deepseek-v4-flash-free
AGENT_HAIKU45_TIER=SMALL
AGENT_HAIKU45_MODEL=opencode/deepseek-v4-flash
